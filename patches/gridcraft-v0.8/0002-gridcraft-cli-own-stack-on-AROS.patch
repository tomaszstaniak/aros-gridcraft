From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Tue, 20 Oct 2026 11:09:44 +0200
Subject: [PATCH] gridcraft-cli: own stack on AROS

Problem: an AROS program runs on the stack of whatever starts it (40,960
  bytes in an AROS One Shell, and whatever an MCP client's process creation
  gives); reading workbooks, recalculation and PDF export overrun that, and
  the overrun takes the system down with it.
Rationale: the command runs on a thread with an 8 MiB stack; its exit code
  returns to the main task (exit() from another thread crashes on ABIv11).
  As in the WordCraft and PhotoCraft ports. The CLI uses no thread pool.
Scope: AROS only; other targets run as before.
Upstream-status: local-only.
Verification: built for x86_64 ABIv11; native runs in the port's evidence.
Removal: when AROS programs get a sufficient stack by other means.
---
 apps/gridcraft-cli/src/main.rs | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/apps/gridcraft-cli/src/main.rs b/apps/gridcraft-cli/src/main.rs
index 152ddbcbea57be7801018aa4e5a03706bcc7931a..4a40926638b8290690f2f158abd638bd311d9a98 100644
--- a/apps/gridcraft-cli/src/main.rs
+++ b/apps/gridcraft-cli/src/main.rs
@@ -59,7 +59,30 @@ fn stdout_failed(e: std::io::Error) -> ! {
     std::process::exit(1);
 }
 
+/// The command thread's stack on AROS (see `main`).
+#[cfg(target_os = "aros")]
+const AROS_STACK: usize = 8 << 20;
+
 fn main() -> ExitCode {
+    #[cfg(not(target_os = "aros"))]
+    let code = cli_main();
+    // An AROS program runs on the stack of whatever starts it: 40,960 bytes in an AROS One
+    // Shell, and whatever an MCP client's process creation gives. Parsing, layout and rendering
+    // overrun that, and the overrun takes the system down with it. The command runs on a thread
+    // with its own stack, so no caller has to know the size; the exit code comes back to the main
+    // task, because ending the process from another thread crashes on AROS.
+    #[cfg(target_os = "aros")]
+    let code = std::thread::Builder::new()
+        .name("gridcraft-cli".into())
+        .stack_size(AROS_STACK)
+        .spawn(cli_main)
+        .map_err(|e| eprintln!("gridcraft-cli: {e}"))
+        .and_then(|worker| worker.join().map_err(|_| eprintln!("gridcraft-cli: the command panicked")))
+        .unwrap_or(ExitCode::FAILURE);
+    code
+}
+
+fn cli_main() -> ExitCode {
     let args: Vec<String> = std::env::args().skip(1).collect();
     let rest = args.get(1..).unwrap_or_default();
     let r = match args.first().map(String::as_str) {
