index 5f662a76075c6d9c94f1c7a4e9b30cdab68ce7e1..48011d48ceb713cc0732dc745a0e98cc61cd817e 100644
--- a/apps/gridcraft-aros/src/services.rs
+++ b/apps/gridcraft-aros/src/services.rs
@@ -84,8 +84,34 @@ fn clipboard_picture() -> Option<image::RgbaImage> {
     }
 }
 
+/// The worker pool as the service the interface hands its saves to: a job the pool cannot take
+/// (its queue is full, or it is shutting down) is given back, and the interface runs it itself.
+pub fn run_on(pool: Rc<craft_jobs::Executor>) -> gridcraft_ui_egui::RunDetached {
+    Box::new(move |task| {
+        // `submit` keeps the closure it is given, so the task sits where it can be taken back.
+        let slot = std::sync::Arc::new(std::sync::Mutex::new(Some(task)));
+        let for_worker = slot.clone();
+        let submitted = pool.submit(move || {
+            let task = for_worker.lock().unwrap_or_else(std::sync::PoisonError::into_inner).take();
+            if let Some(task) = task {
+                task();
+            }
+        });
+        match submitted {
+            Ok(_) => Ok(()),
+            Err(why) => {
+                log::warn!("a job runs in the window loop: {why}");
+                match slot.lock().unwrap_or_else(std::sync::PoisonError::into_inner).take() {
+                    Some(task) => Err(task),
+                    None => Ok(()),
+                }
+            }
+        }
+    })
+}
+
 /// The services for this host.
-pub fn aros(window: SharedWindow) -> Services {
+pub fn aros(window: SharedWindow, run_detached: Option<gridcraft_ui_egui::RunDetached>) -> Services {
     let last_dir: Rc<RefCell<String>> = Rc::new(RefCell::new(String::new()));
     let (open_window, picture_window, save_window) = (window.clone(), window.clone(), window);
     let (open_dir, picture_dir, save_dir) = (last_dir.clone(), last_dir.clone(), last_dir);
@@ -112,6 +138,7 @@ pub fn aros(window: SharedWindow) -> Services {
         paste_text: Some(Box::new(egui_aros::clipboard_text)),
         paste_image: Some(Box::new(clipboard_picture)),
         open_url: Some(Box::new(open_link)),
+        run_detached,
         ..Default::default()
     }
 }
