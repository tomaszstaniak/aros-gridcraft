From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:12:25 +0100
Subject: [PATCH] AROS: build without the self-updater

Releases for AROS come through the AROS package catalogue, and craft-update's HTTPS stack (hyper, rustls, aws-lc-sys with its C/CMake build) has no AROS build. The updater is left out on target_os = "aros" the way the web build leaves it out; Check for Updates says where AROS updates come from.
---
 crates/ui-egui/Cargo.toml       |  6 +++++-
 crates/ui-egui/src/app.rs       |  8 ++++----
 crates/ui-egui/src/app/prefs.rs | 13 +++++++++----
 crates/ui-egui/src/lib.rs       |  6 +++---
 4 files changed, 21 insertions(+), 12 deletions(-)

diff --git a/crates/ui-egui/Cargo.toml b/crates/ui-egui/Cargo.toml
index 6486631b5ab8ba7fc5d8617b64fbca68f06740d9..d38b80cc729c0d7f0308eefc8fa80fee6d27967f 100644
--- a/crates/ui-egui/Cargo.toml
+++ b/crates/ui-egui/Cargo.toml
@@ -38,8 +38,12 @@ egui_kittest = { workspace = true, features = ["wgpu", "snapshot"] }
 epaint_default_fonts = { workspace = true }
 gridcraft-xlsx = { workspace = true, features = ["test-support"] }
 
-[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
+# AROS: no self-update. Releases come through the AROS package catalogue, and the updater's
+# HTTPS stack (hyper, rustls, aws-lc-sys with its C/CMake build) has no AROS build.
+[target.'cfg(not(any(target_arch = "wasm32", target_os = "aros")))'.dependencies]
 craft-update = { workspace = true }
+
+[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
 # The desktop's preferred language for the first-run interface language.
 sys-locale = { workspace = true }
 craft-window = { workspace = true }
diff --git a/crates/ui-egui/src/app.rs b/crates/ui-egui/src/app.rs
index 535c91a5c821c86eae587d1e45253124a76943db..5ecc4768ed5a4fdd827302f64e605cf1ed774591 100644
--- a/crates/ui-egui/src/app.rs
+++ b/crates/ui-egui/src/app.rs
@@ -3,7 +3,7 @@ use super::clock::monotonic_ms;
 use super::clock::now_ms;
 use super::services::{Chrome, Services};
 use super::state::{NoticeKind, OpenWindow, SaveAnswer, SheetView};
-#[cfg(not(target_arch = "wasm32"))]
+#[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
 use super::updates_ui;
 use super::{
     CellRef, HashMap, INTERFACE_SCALE_MAX, INTERFACE_SCALE_MIN, Json, Notice, Perf, RangeRef, Session, SheetApp, UiRequest, UiState, backstage,
@@ -84,7 +84,7 @@ impl SheetApp {
             parked: HashMap::new(),
             native_windows: false,
             arrange_windows: None,
-            #[cfg(not(target_arch = "wasm32"))]
+            #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
             updates_rt: Default::default(),
         }
     }
@@ -138,7 +138,7 @@ impl SheetApp {
         // frames still see worker completion. `ui` and the desktop app no longer poll it.
         self.poll_printing(ctx);
         self.guard_window_close(ctx);
-        #[cfg(not(target_arch = "wasm32"))]
+        #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
         updates_ui::tick(self, ctx);
         // Files read asynchronously (web file picker, dropped files).
         self.poll_async_opens();
@@ -210,7 +210,7 @@ impl SheetApp {
         }
         // The language the widgets translate with this frame (see `i18n::current`).
         i18n::set_current(&ctx, self.ui.language);
-        #[cfg(not(target_arch = "wasm32"))]
+        #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
         updates_ui::show(self, &ctx);
         let t = theme::Tokens::get(&ctx);
         // A host can turn the File tab off while Backstage is already open: close it.
diff --git a/crates/ui-egui/src/app/prefs.rs b/crates/ui-egui/src/app/prefs.rs
index 151374e6e461dce4ede19d42cdd5ec251f99d004..b92d9ad1913d603820af5536e7b43720657fc473 100644
--- a/crates/ui-egui/src/app/prefs.rs
+++ b/crates/ui-egui/src/app/prefs.rs
@@ -1,4 +1,4 @@
-#[cfg(not(target_arch = "wasm32"))]
+#[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
 use super::updates_ui;
 use super::{SheetApp, desktop_theme};
 
@@ -51,25 +51,30 @@ impl SheetApp {
     /// Look for a newer release once, in the background, as the desktop app starts (a no-op on the
     /// web). A found release opens the update prompt; nothing is shown when GridCraft is current.
     pub fn start_update_check(&mut self) {
-        #[cfg(not(target_arch = "wasm32"))]
+        #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
         updates_ui::start(self, false);
     }
 
     /// Help ▸ Check for Updates…: look now, and say so when GridCraft is up to date or the check fails.
     pub fn check_for_updates(&mut self) {
-        #[cfg(not(target_arch = "wasm32"))]
+        #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
         updates_ui::start(self, true);
         #[cfg(target_arch = "wasm32")]
         {
             self.message = Some(("GridCraft".into(), "The web version is always the latest release.".into()));
         }
+        // AROS: releases come through the AROS package catalogue (no self-update there).
+        #[cfg(target_os = "aros")]
+        {
+            self.message = Some(("GridCraft".into(), "Updates for AROS come through the AROS package manager.".into()));
+        }
     }
 
     /// Starts the install helper of an update that is ready, so it installs once the process has
     /// exited (a no-op on the web, and when no update is ready). Call it in `on_exit` when the
     /// process ends there, since the app is then never dropped.
     pub fn start_pending_update(&mut self) {
-        #[cfg(not(target_arch = "wasm32"))]
+        #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
         updates_ui::start_pending_update(self);
     }
 }
diff --git a/crates/ui-egui/src/lib.rs b/crates/ui-egui/src/lib.rs
index ce7ce347b5165fc63c88b38abac8e0b46e93bdb0..0bc3383881dd1e7c9fb179b603fe3636cbc33641 100644
--- a/crates/ui-egui/src/lib.rs
+++ b/crates/ui-egui/src/lib.rs
@@ -8,7 +8,7 @@
 
 /// GridCraft as craft-update knows it, with its 128 px icon and accent colour: the update
 /// prompt shows both, and an AppImage's menu entry gets the icon.
-#[cfg(not(target_arch = "wasm32"))]
+#[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
 pub const UPDATE_APP: craft_update::app::App = craft_update::app::App {
     icon_png: Some(include_bytes!("../../../assets/app-icon/hicolor/128x128/apps/ai.storyteller.gridcraft.png")),
     accent: Some([0x1f, 0x9d, 0x55]),
@@ -56,7 +56,7 @@ pub mod tabs;
 pub mod text_box;
 mod text_direction;
 pub mod theme;
-#[cfg(not(target_arch = "wasm32"))]
+#[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
 mod updates_ui;
 pub mod widgets;
 mod window_ui;
@@ -326,7 +326,7 @@ pub struct SheetApp {
     /// View › Arrange All's layout and windows, waiting for the native windows to move.
     pub arrange_windows: Option<(String, Vec<u64>)>,
     /// The update check, the startup prompt and a running self-update (desktop only).
-    #[cfg(not(target_arch = "wasm32"))]
+    #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
     updates_rt: updates_ui::Runtime,
 }
 
