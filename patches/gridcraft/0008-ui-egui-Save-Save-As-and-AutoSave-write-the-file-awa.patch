+#[test]
+fn two_workbooks_saving_to_one_file_take_turns() {
+    let dir = dir("turns");
+    let path = dir.join("book.xlsx");
+    let (mut h, held) = harness_with_worker();
+    h.state_mut().run("file.save", json!({"path": path.to_str().unwrap()})).unwrap();
+    // A second workbook, saved over the same file while the first is being written.
+    h.state_mut().run("file.new", json!({})).unwrap();
+    set(&mut h, "A1", "second workbook");
+    h.state_mut().run("file.save", json!({"path": path.to_str().unwrap()})).unwrap();
+    assert_eq!(held.borrow().len(), 1, "the second waits");
+    work(&mut h, &held);
+    assert_eq!(value_in(&path, "A1"), Value::Number(1.0));
+    assert_eq!(held.borrow().len(), 1, "then takes its turn");
+    work(&mut h, &held);
+    assert_eq!(value_in(&path, "A1"), Value::Text("second workbook".into()), "in the order they were asked");
+    let _ = std::fs::remove_dir_all(&dir);
+}
