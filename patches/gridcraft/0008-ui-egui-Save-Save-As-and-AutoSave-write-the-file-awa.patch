+#[test]
+fn the_window_goes_on_while_the_file_is_written() {
+    let dir = dir("goes-on");
+    let path = dir.join("book.xlsx");
+    let (mut h, held) = harness_with_worker();
+    let answer = h.state_mut().run("file.save", json!({"path": path.to_str().unwrap()})).unwrap();
+    assert_eq!(answer, json!({"pending": true}));
+    assert_eq!(held.borrow().len(), 1, "the writing went to the worker");
+    assert_eq!(h.state().saves_pending(), 1);
+    // The worker has not run: frames, selection and typing go on.
+    h.run_steps(10);
+    set(&mut h, "B1", "typed while saving");
+    h.state_mut().run("selection.set", json!({"cell": "D4"})).unwrap();
+    h.run_steps(3);
+    assert!(!path.exists());
+    assert!(dirty(&h));
+    assert_eq!(work(&mut h, &held), 1);
+    assert_eq!(h.state().saves_pending(), 0);
+    assert_eq!(value_in(&path, "A1"), Value::Number(1.0));
+    assert_eq!(h.state().session.active().unwrap().path.as_deref(), path.to_str());
+    let _ = std::fs::remove_dir_all(&dir);
+}
