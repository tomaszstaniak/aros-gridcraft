+//! Saving with a host that runs work away from the interface: the window goes on while the file
+//! is written, an edit made meanwhile stays unsaved, no save is dropped, a failure is shown, and
+//! closing waits for the file.
+
+#[path = "common/mod.rs"]
+#[allow(dead_code)]
+mod common;
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use common::Harness;
+use gridcraft_engine::Session;
+use gridcraft_engine::core::{CellRef, Value};
+use gridcraft_ui_egui::{DetachedTask, Services, SheetApp};
+use serde_json::json;
+
+/// The host's worker, held by the test: tasks wait here until the test runs them.
+type Held = Rc<RefCell<Vec<DetachedTask>>>;
+
+fn harness_with_worker() -> (Harness, Held) {
+    let held: Held = Rc::default();
+    let queue = held.clone();
+    let services = Services {
+        run_detached: Some(Box::new(move |task| {
+            queue.borrow_mut().push(task);
+            Ok(())
+        })),
+        ..Default::default()
+    };
+    let mut session = Session::new();
+    session.new_workbook();
+    session.execute("cell.set", json!({"cell": "A1", "input": "1"})).unwrap();
+    let app = common::prepare(SheetApp::new(session, services));
+    let h = common::harness_with(common::builder().with_size(egui::vec2(1000.0, 700.0)), app, 4);
+    (h, held)
+}
+
+/// Runs the tasks the worker holds (as its thread would) and the frames that record them.
+fn work(h: &mut Harness, held: &Held) -> usize {
+    let tasks: Vec<DetachedTask> = held.borrow_mut().drain(..).collect();
+    let n = tasks.len();
+    for task in tasks {
+        task();
+    }
+    h.run_steps(3);
+    n
+}
+
+fn dir(name: &str) -> std::path::PathBuf {
+    let dir = std::env::temp_dir().join(format!("gridcraft-ui-save-{}-{name}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+fn value_in(path: &std::path::Path, cell: &str) -> Value {
+    let mut s = Session::new();
+    s.execute("file.open", json!({"path": path.to_str().unwrap()})).unwrap();
+    s.active().unwrap().wb.active().unwrap().value(CellRef::parse(cell).unwrap())
+}
+
+fn dirty(h: &Harness) -> bool {
+    h.state().session.active().unwrap().is_dirty()
+}
+
+fn set(h: &mut Harness, cell: &str, input: &str) {
+    h.state_mut().run("cell.set", json!({"cell": cell, "input": input})).unwrap();
+    h.run_steps(2);
+}
