--- /dev/null
+++ b/crates/ui-egui/src/save_jobs.rs
@@ -0,0 +1,223 @@
+//! Saves that run away from the interface.
+//!
+//! Serializing a workbook and writing the file can take long enough to freeze the window. When
+//! the host provides [`Services::run_detached`](crate::Services::run_detached), Save, Save As
+//! and AutoSave take the workbook's snapshot in the frame they are asked in, hand the writing
+//! to the host, and record the result in the frame after it is done (the engine's
+//! `save_job`). The workbook can be edited meanwhile: an edit made while the file is written
+//! stays unsaved.
+//!
+//! Rules kept here:
+//! - one file is written by one job at a time, also when two workbooks save to the same path;
+//! - an explicit save asked for while that workbook or file is being written is not dropped:
+//!   it waits and then writes the workbook as it is by then. An AutoSave in that case is left
+//!   out (the next one comes by itself);
+//! - a failed save says so and leaves the workbook open and unsaved;
+//! - a save started from "Save Changes?" closes the workbook only after the file is written,
+//!   and asks again when the workbook was edited meanwhile;
+//! - the window does not close while a save is on its way.
+//!
+//! Without the service, while actions are recorded or a macro is debugged, for a PDF and for
+//! commands from the control channel, `file.save` runs as one call, as before.
+
+use std::collections::VecDeque;
+use std::sync::mpsc::{Receiver, Sender, channel};
+
+use gridcraft_engine::save_job::SaveCompleted;
+use serde_json::json;
+
+use super::SheetApp;
+
+/// What follows a save that succeeded.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum AfterSave {
+    Nothing,
+    /// Close the workbook (the answer "Save" to "Save Changes?"); `quitting`: then go on closing
+    /// the app.
+    Close {
+        quitting: bool,
+    },
+}
+
+struct Running {
+    doc: u64,
+    path: String,
+    after: AfterSave,
+}
+
+struct Waiting {
+    doc: u64,
+    path: String,
+    after: AfterSave,
+}
+
+type Finished = (u64, String, Result<SaveCompleted, String>);
+
+pub(crate) struct SaveJobs {
+    running: Vec<Running>,
+    waiting: VecDeque<Waiting>,
+    finished: (Sender<Finished>, Receiver<Finished>),
+    /// The window was asked to close while a save was on its way: go on once none is.
+    quit_when_done: bool,
+    /// While above zero, saves run as one call (the control channel answers with the result).
+    inline: u32,
+}
+
+impl Default for SaveJobs {
+    fn default() -> Self {
+        Self { running: Vec::new(), waiting: VecDeque::new(), finished: channel(), quit_when_done: false, inline: 0 }
+    }
+}
+
+/// Whether two paths name one file, as far as can be told without it existing: the same after
+/// resolving what exists of them, without regard to case (most AROS file systems ignore it, and
+/// treating two files as one here only makes their saves take turns).
+fn same_file(a: &str, b: &str) -> bool {
+    let resolve = |p: &str| {
+        let path = std::path::Path::new(p);
+        let resolved = std::fs::canonicalize(path).ok().or_else(|| {
+            let (dir, name) = (path.parent()?, path.file_name()?);
+            Some(std::fs::canonicalize(dir).ok()?.join(name))
+        });
+        resolved.unwrap_or_else(|| path.to_path_buf()).to_string_lossy().to_lowercase()
+    };
+    a == b || resolve(a) == resolve(b)
+}
+
+impl SheetApp {
+    /// Saves on their way or waiting for their turn.
+    pub fn saves_pending(&self) -> usize {
+        self.save_jobs.running.len() + self.save_jobs.waiting.len()
+    }
+
+    /// Whether a save of workbook `doc` is on its way or waiting.
+    pub(crate) fn save_pending_for(&self, doc: u64) -> bool {
+        self.save_jobs.running.iter().any(|r| r.doc == doc) || self.save_jobs.waiting.iter().any(|w| w.doc == doc)
+    }
+
+    /// Runs `f` with saves as one call each: for callers that answer with the save's result.
+    pub(crate) fn with_inline_saves<R>(&mut self, f: impl FnOnce(&mut Self) -> R) -> R {
+        self.save_jobs.inline += 1;
+        let r = f(self);
+        self.save_jobs.inline = self.save_jobs.inline.saturating_sub(1);
+        r
+    }
+
+    /// Starts saving workbook `doc` away from the interface, to `path` or to its own file.
+    /// `false`: not possible here (see the module text); the caller runs `file.save`. `true`:
+    /// the save is on its way or waits for its turn, or it was an AutoSave left out because
+    /// that workbook or file is being written.
+    pub(crate) fn save_detached(&mut self, doc: u64, path: Option<String>, auto: bool, after: AfterSave) -> bool {
+        if self.save_jobs.inline > 0 || self.services.run_detached.is_none() || self.wake_ctx.is_none() || !self.session.save_can_be_detached() {
+            return false;
+        }
+        // The scroll position and active cell are saved with the file.
+        if self.session.active().is_some_and(|d| d.uid == doc) {
+            self.store_view_state();
+        }
+        let Ok(Some(job)) = self.session.prepare_save(doc, path.as_deref()) else { return false };
+        let target = job.path().to_string();
+        let busy = self.save_jobs.running.iter().any(|r| r.doc == doc || same_file(&r.path, &target));
+        if busy {
+            if !auto {
+                // Written when its turn comes, from the workbook as it is then.
+                match self.save_jobs.waiting.iter_mut().find(|w| w.doc == doc && w.path == target) {
+                    Some(w) if after != AfterSave::Nothing => w.after = after,
+                    Some(_) => {}
+                    None => self.save_jobs.waiting.push_back(Waiting { doc, path: target, after }),
+                }
+            }
+            return true;
+        }
+        self.start_save(job, after);
+        true
+    }
+
+    fn start_save(&mut self, job: gridcraft_engine::save_job::SaveJob, after: AfterSave) {
+        let (doc, path) = (job.doc(), job.path().to_string());
+        let (Some(run), Some(ctx)) = (self.services.run_detached.as_ref(), self.wake_ctx.clone()) else { return };
+        let finished = self.save_jobs.finished.0.clone();
+        let sent_path = path.clone();
+        let task: crate::services::DetachedTask = Box::new(move || {
+            let result = job.run().map_err(|e| e.to_string());
+            let _ = finished.send((doc, sent_path, result));
+            ctx.request_repaint();
+        });
+        // A host that cannot take the job now gives it back: it runs here, and its result is
+        // recorded like any other.
+        if let Err(task) = run(task) {
+            task();
+        }
+        self.save_jobs.running.push(Running { doc, path, after });
+    }
+
+    /// Records the saves that finished and starts those whose turn has come. Called every frame.
+    pub(crate) fn poll_saves(&mut self, ctx: &egui::Context) {
+        while let Ok((doc, path, result)) = self.save_jobs.finished.1.try_recv() {
+            let after = match self.save_jobs.running.iter().position(|r| r.doc == doc && r.path == path) {
+                Some(i) => self.save_jobs.running.remove(i).after,
+                None => AfterSave::Nothing,
+            };
+            match result {
+                Ok(done) => {
+                    self.session.finish_save(done);
+                    self.session.note_detached_save(&path);
+                    self.after_save(doc, after, ctx);
+                }
+                // The workbook stays open and unsaved; a close that waited for this save is off.
+                Err(e) => {
+                    self.save_jobs.quit_when_done = false;
+                    self.message = Some(("GridCraft".into(), e));
+                }
+            }
+        }
+        // Waiting saves whose workbook and file are free now, oldest first.
+        let mut i = 0;
+        while i < self.save_jobs.waiting.len() {
+            let free =
+                self.save_jobs.waiting.get(i).is_some_and(|w| !self.save_jobs.running.iter().any(|r| r.doc == w.doc || same_file(&r.path, &w.path)));
+            if !free {
+                i += 1;
+                continue;
+            }
+            let Some(w) = self.save_jobs.waiting.remove(i) else { break };
+            // A workbook closed meanwhile has nothing to write.
+            if let Ok(Some(job)) = self.session.prepare_save(w.doc, Some(&w.path)) {
+                self.start_save(job, w.after);
+            }
+        }
+        if self.saves_pending() == 0 && std::mem::take(&mut self.save_jobs.quit_when_done) {
+            self.continue_quit(ctx);
+        }
+    }
+
+    fn after_save(&mut self, doc: u64, after: AfterSave, ctx: &egui::Context) {
+        let AfterSave::Close { quitting } = after else { return };
+        let Some(dirty) = self.session.documents().iter().find(|d| d.uid == doc).map(|d| d.is_dirty()) else { return };
+        if let Some(window) = self.session.doc_window(doc)
+            && self.ui_window() != Some(window)
+        {
+            self.enter_window(window);
+        }
+        if dirty {
+            // Edited after "Save" was chosen: those changes are asked about again.
+            let title = self.session.active().map(|d| d.display_title()).unwrap_or_default();
+            self.open_dialog("saveChanges", json!({"title": title, "quit": quitting}));
+            return;
+        }
+        self.run_or_alert("file.close", json!({"force": true, "document": true}));
+        if quitting {
+            self.continue_quit(ctx);
+        }
+    }
+
+    /// The window is closing: holds the close back while a save is on its way, and goes on with
+    /// it afterwards. Returns whether the close has to wait.
+    pub(crate) fn hold_close_for_saves(&mut self) -> bool {
+        if self.saves_pending() == 0 {
+            return false;
+        }
+        self.save_jobs.quit_when_done = true;
+        true
+    }
+}
