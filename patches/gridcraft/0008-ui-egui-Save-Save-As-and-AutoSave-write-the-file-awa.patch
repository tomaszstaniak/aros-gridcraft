+#[test]
+fn autosave_is_left_out_while_the_file_is_being_written() {
+    let dir = dir("autosave");
+    let path = dir.join("book.xlsx");
+    let (mut h, held) = harness_with_worker();
+    h.state_mut().run("file.save", json!({"path": path.to_str().unwrap()})).unwrap();
+    work(&mut h, &held);
+    // AutoSave on, a change, and the pause after it over: AutoSave saves away from the window.
+    h.state_mut().ui.autosave = true;
+    set(&mut h, "A3", "3");
+    h.state_mut().grid.last_autosave = gridcraft_ui_egui::monotonic_ms() - 3000.0;
+    h.run_steps(2);
+    assert_eq!(held.borrow().len(), 1, "AutoSave went to the worker");
+    // Another change and another AutoSave time while that one is still being written.
+    set(&mut h, "A4", "4");
+    h.state_mut().grid.last_autosave = gridcraft_ui_egui::monotonic_ms() - 3000.0;
+    h.run_steps(2);
+    assert_eq!(held.borrow().len(), 1, "no second job for the file");
+    assert_eq!(h.state().saves_pending(), 1, "and none waiting: the next AutoSave comes by itself");
+    work(&mut h, &held);
+    assert_eq!(value_in(&path, "A3"), Value::Number(3.0));
+    assert!(dirty(&h), "A4 is still to be saved");
+    let _ = std::fs::remove_dir_all(&dir);
+}
