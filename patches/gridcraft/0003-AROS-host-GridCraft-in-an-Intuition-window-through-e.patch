@@ -0,0 +1,157 @@
+//! The platform services the spreadsheet uses on AROS: ASL file requesters, the system
+//! clipboard's text and pictures, and opening links. The same contract as the desktop app's
+//! `services` (apps/gridcraft/src/main.rs), without rfd, arboard and craft-print, which have no
+//! AROS backend. Copy writes plain text through egui-aros (Ctrl/Amiga+C, X); HTML on the
+//! clipboard and printing are left out (`None`), which the app handles as "not available".
+//!
+//! Paths: the program runs in the -nix path mode; requesters speak DOS names, converted at this
+//! edge (egui_aros::startup).
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use egui_aros::WindowHandle;
+use egui_aros::asl::{Select, request};
+use egui_aros::startup::{dos_to_nix, nix_to_dos};
+use gridcraft_ui_egui::Services;
+
+/// The window the requesters are parented to, set once the window is open (the requester runs on
+/// the main thread, modally, while the loop is inside the service call). The handle holds the
+/// window weakly: after it closes, a requester opens without a parent.
+pub type SharedWindow = Rc<RefCell<Option<WindowHandle>>>;
+
+/// Workbooks File › Open reads: the desktop app's filter, as an AmigaDOS pattern (matched without
+/// regard to case).
+const WORKBOOKS: &str = "#?.(xlsx|xlsm|xls|xlsb|ods|csv|tsv|txt|slk|json)";
+const PICTURES: &str = "#?.(png|jpg|jpeg)";
+/// The types Save As offers; the suggested name's own type (an export asks for .pdf, .csv or
+/// .html) is kept, anything else becomes .xlsx, as in the desktop app.
+const SAVE_TYPES: [&str; 4] = ["xlsx", "csv", "html", "pdf"];
+
+/// The file name part of a path (`a.xlsx` for `/Work/Books/a.xlsx`).
+pub fn file_part(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// The drawer part of a -nix path (`/Work/Books` for `/Work/Books/a.xlsx`).
+pub fn dir_part(path: &str) -> &str {
+    match path.rfind('/') {
+        Some(0) | None => "",
+        Some(i) => path.get(..i).unwrap_or(""),
+    }
+}
+
+/// The name Save As suggests: the stem of `suggested` with its type when it is one of
+/// [`SAVE_TYPES`], otherwise `.xlsx`.
+pub fn save_name(suggested: &str) -> String {
+    let name = file_part(suggested);
+    let (stem, ext) = match name.rsplit_once('.') {
+        Some((stem, ext)) if !stem.is_empty() => (stem, ext.to_ascii_lowercase()),
+        _ => (name, String::new()),
+    };
+    let stem = if stem.is_empty() { "Book1" } else { stem };
+    let ext = if SAVE_TYPES.contains(&ext.as_str()) { ext } else { "xlsx".to_owned() };
+    format!("{stem}.{ext}")
+}
+
+/// One file from an ASL requester, as a -nix path; `dir` is the -nix drawer it opens in.
+fn pick(window: &SharedWindow, select: Select, title: &str, dir: &str, file: &str, pattern: &str) -> Option<String> {
+    let win = window.borrow().clone()?;
+    let start = if dir.is_empty() { String::new() } else { nix_to_dos(dir).unwrap_or_default() };
+    let dos = request(&win, select, title, &start, file, pattern).into_iter().next()?;
+    match dos_to_nix(&dos) {
+        Ok(p) => Some(p),
+        Err(e) => {
+            log::warn!("requester: {dos}: {e}");
+            None
+        }
+    }
+}
+
+/// The picture on the system clipboard for Paste, or none (also when it cannot be read: the
+/// reason goes to the log).
+fn clipboard_picture() -> Option<image::RgbaImage> {
+    match egui_aros::clipboard_image() {
+        egui_aros::ClipboardImage::None => None,
+        egui_aros::ClipboardImage::Pixels { width, height, rgba } => {
+            log::info!("clipboard picture: {width}x{height}");
+            image::RgbaImage::from_raw(width, height, rgba)
+        }
+        egui_aros::ClipboardImage::Unreadable(why) => {
+            log::warn!("clipboard picture: {why}");
+            None
+        }
+    }
+}
+
+/// The services for this host.
+pub fn aros(window: SharedWindow) -> Services {
+    let last_dir: Rc<RefCell<String>> = Rc::new(RefCell::new(String::new()));
+    let (open_window, picture_window, save_window) = (window.clone(), window.clone(), window);
+    let (open_dir, picture_dir, save_dir) = (last_dir.clone(), last_dir.clone(), last_dir);
+    Services {
+        pick_open: Some(Box::new(move || {
+            let dir = open_dir.borrow().clone();
+            let path = pick(&open_window, Select::Open, "Open", &dir, "", WORKBOOKS)?;
+            *open_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        pick_picture: Some(Box::new(move || {
+            let dir = picture_dir.borrow().clone();
+            let path = pick(&picture_window, Select::Open, "Insert Picture", &dir, "", PICTURES)?;
+            *picture_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        pick_save: Some(Box::new(move |suggested: &str| {
+            let dir = dir_part(suggested).to_string();
+            let dir = if dir.is_empty() { save_dir.borrow().clone() } else { dir };
+            let path = pick(&save_window, Select::Save, "Save As", &dir, &save_name(suggested), "")?;
+            *save_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        paste_text: Some(Box::new(egui_aros::clipboard_text)),
+        paste_image: Some(Box::new(clipboard_picture)),
+        open_url: Some(Box::new(open_link)),
+        ..Default::default()
+    }
+}
+
+/// Opens a link with the system's OpenURL. As in the desktop app, only http, https and mailto
+/// addresses are passed on.
+fn open_link(target: &str) {
+    let gridcraft_engine::links::LinkKind::External(target) = gridcraft_engine::links::classify(target) else {
+        log::warn!("refused to open {target:?}: only http, https and mailto links are opened");
+        return;
+    };
+    if !egui_aros::open_url(&target) {
+        log::warn!("OpenURL {target} failed");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn path_parts() {
+        assert_eq!(file_part("/Work/Books/a.xlsx"), "a.xlsx");
+        assert_eq!(dir_part("/Work/Books/a.xlsx"), "/Work/Books");
+        assert_eq!(dir_part("/RAM"), "");
+        assert_eq!(dir_part("a.xlsx"), "");
+    }
+
+    #[test]
+    fn save_keeps_export_types_and_defaults_to_xlsx() {
+        assert_eq!(save_name("Book1"), "Book1.xlsx");
+        assert_eq!(save_name("/RAM/Report.PDF"), "Report.pdf");
+        assert_eq!(save_name("Data.csv"), "Data.csv");
+        assert_eq!(save_name("Old.xls"), "Old.xlsx");
+        assert_eq!(save_name(""), "Book1.xlsx");
+    }
+
+    #[test]
+    fn the_open_pattern_fits_the_requester() {
+        // asl.library copies the pattern into a 257-byte gadget without a length check.
+        assert!(WORKBOOKS.len() <= 255);
+    }
+}
