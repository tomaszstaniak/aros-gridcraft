@@ -0,0 +1,615 @@
+//! GridCraft on AROS.
+//!
+//! The egui interface (`gridcraft-ui-egui`) runs in an Intuition window through egui-aros: winit
+//! and egui-winit for the window and input, the CPU renderer or OpenGL for the pixels (chosen at
+//! run time: `--gui-renderer`, ToolType `GUI_RENDERER`), ASL for files, the system clipboard for
+//! text and pictures. The engine, workbooks and file formats are the same as on the other
+//! platforms; this file and `services` follow the desktop app (apps/gridcraft/src/main.rs). Not
+//! here: the localhost control server (`--control`), printing, HTML on the clipboard, the
+//! self-updater and a native window per workbook window.
+//!
+//! `--screenshot <file>` writes the window's pixels after `--screenshot-frames` frames (20 by
+//! default) and quits: a way to look at the interface where no display can be watched.
+//! `--window` sets the inner size. Settings and the log are kept in `GridCraftData` in the
+//! program's drawer (or `GRIDCRAFT_CONFIG_DIR`).
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+mod services;
+
+use std::cell::RefCell;
+use std::path::PathBuf;
+use std::rc::Rc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use egui_aros::{launch, startup};
+use gridcraft_ui_egui::SheetApp;
+
+/// The release name packaging gives (`--version`, the log), else the crate version.
+const RELEASE: &str = match option_env!("GRIDCRAFT_RELEASE") {
+    Some(r) => r,
+    None => env!("CARGO_PKG_VERSION"),
+};
+const TARGET: &str = match option_env!("GRIDCRAFT_BUILD_TARGET") {
+    Some(t) => t,
+    None => "aros",
+};
+
+const USAGE: &str = "\
+GridCraft for AROS
+
+Usage: GridCraft [--gui-renderer CPU|AUTO|GPU] [--sample <name>] [--window <w>x<h>]
+                 [--screenshot <file.png> [--screenshot-frames <n>]] [--test-steps <file.json>] [FILE...]
+";
+
+struct Logger;
+
+impl log::Log for Logger {
+    fn enabled(&self, metadata: &log::Metadata) -> bool {
+        metadata.level() <= log::max_level()
+    }
+
+    fn log(&self, record: &log::Record) {
+        if self.enabled(record.metadata()) {
+            log_line(&format!("{} {}: {}", record.level(), record.target(), record.args()));
+        }
+    }
+
+    fn flush(&self) {}
+}
+
+static LOGGER: Logger = Logger;
+
+/// The log file: `GRIDCRAFT_LOG` if set, else `GridCraft.log` in the settings folder. A program
+/// started from Workbench has no console, and the AROS Shell cannot redirect a command's error
+/// output, so a failure would otherwise leave nothing to read. Shell starts also print it.
+static LOG_FILE: std::sync::OnceLock<Option<Mutex<std::fs::File>>> = std::sync::OnceLock::new();
+static SHELL: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+fn log_line(line: &str) {
+    use std::io::Write;
+    let file = LOG_FILE.get_or_init(|| {
+        let path = std::env::var_os("GRIDCRAFT_LOG")
+            .filter(|p| !p.is_empty())
+            .map(PathBuf::from)
+            .or_else(|| prefs_enabled().then(|| config_dir().map(|d| d.join("GridCraft.log"))).flatten())?;
+        std::fs::OpenOptions::new().create(true).append(true).open(path).ok().map(Mutex::new)
+    });
+    if let Some(file) = file {
+        let mut file = file.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        let _ = writeln!(file, "gridcraft: {line}");
+        let _ = file.flush();
+    }
+    if SHELL.load(std::sync::atomic::Ordering::Relaxed) || file.is_none() {
+        let _ = writeln!(std::io::stderr(), "gridcraft: {line}");
+    }
+}
+
+fn install_logger() {
+    let level = match std::env::var("RUST_LOG").ok().as_deref().map(str::trim) {
+        Some("trace") => log::LevelFilter::Trace,
+        Some("debug") => log::LevelFilter::Debug,
+        Some("warn") => log::LevelFilter::Warn,
+        Some("error") => log::LevelFilter::Error,
+        Some("off") => log::LevelFilter::Off,
+        _ => log::LevelFilter::Info,
+    };
+    // Log every panic before the default hook prints it, so it also reaches the log file.
+    let default_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(move |info| {
+        log::error!("GridCraft internal error: {info}");
+        default_hook(info);
+    }));
+    if log::set_logger(&LOGGER).is_ok() {
+        log::set_max_level(level);
+    }
+}
+
+struct Options {
+    files: Vec<String>,
+    sample: Option<String>,
+    window: Option<(i32, i32)>,
+    screenshot: Option<String>,
+    screenshot_frames: u64,
+    test_steps: Vec<Step>,
+}
+
+/// One step of `--test-steps`: at frame `frame`, run a command (as the ribbon and menus do), take
+/// a screenshot or quit. A test aid for systems where the window cannot be driven reliably by
+/// pointer and keys (slow emulated frames); each command's result is logged.
+#[derive(Debug)]
+struct Step {
+    frame: u64,
+    run: Option<(String, serde_json::Value)>,
+    screenshot: Option<String>,
+    quit: bool,
+}
+
+fn read_steps(path: &str) -> Result<Vec<Step>, String> {
+    let text = std::fs::read_to_string(path).map_err(|e| format!("--test-steps {path}: {e}"))?;
+    let list: Vec<serde_json::Value> = serde_json::from_str(&text).map_err(|e| format!("--test-steps {path}: {e}"))?;
+    let mut steps = Vec::new();
+    for v in list {
+        let frame = v.get("frame").and_then(serde_json::Value::as_u64).ok_or_else(|| format!("--test-steps: a step without a frame: {v}"))?;
+        steps.push(Step {
+            frame,
+            run: v.get("run").and_then(serde_json::Value::as_str).map(|id| (id.to_owned(), v.get("params").cloned().unwrap_or(serde_json::json!({})))),
+            screenshot: v.get("screenshot").and_then(serde_json::Value::as_str).map(str::to_owned),
+            quit: v.get("quit").and_then(serde_json::Value::as_bool).unwrap_or(false),
+        });
+    }
+    steps.sort_by_key(|s| s.frame);
+    Ok(steps)
+}
+
+/// The Shell arguments after the renderer choice was taken out. Document names are resolved by
+/// DOS now, in the directory they were typed in (volumes, assigns, relative names, `/` parents).
+fn parse_args(args: Vec<String>) -> Result<Option<Options>, String> {
+    let mut o = Options { files: Vec::new(), sample: None, window: None, screenshot: None, screenshot_frames: 20, test_steps: Vec::new() };
+    let mut args = args.into_iter().peekable();
+    while let Some(a) = args.next() {
+        match a.as_str() {
+            "--help" | "-h" => {
+                println!("{USAGE}\n{}", launch::HELP);
+                return Ok(None);
+            }
+            "--version" | "-V" => {
+                println!("GridCraft {RELEASE} for AROS ({TARGET})");
+                return Ok(None);
+            }
+            // `--sample` alone is the sales sample, as in the desktop app.
+            "--sample" => o.sample = Some(args.next_if(|n| !n.starts_with("--")).unwrap_or_else(|| "sales".to_owned())),
+            "--control" | "--control-token" => return Err(format!("{a}: the control server is not available on AROS")),
+            "--window" => {
+                let v = args.next().unwrap_or_default();
+                let size = v.split_once('x').and_then(|(w, h)| Some((w.parse().ok()?, h.parse().ok()?)));
+                o.window = Some(size.ok_or_else(|| format!("--window: \"{v}\" is not <width>x<height>"))?);
+            }
+            "--screenshot" => o.screenshot = args.next(),
+            "--test-steps" => o.test_steps = read_steps(&args.next().unwrap_or_default())?,
+            "--screenshot-frames" => {
+                let v = args.next().unwrap_or_default();
+                o.screenshot_frames = v.parse().map_err(|_| format!("--screenshot-frames: \"{v}\" is not a number"))?;
+            }
+            "--" => {
+                for name in args.by_ref() {
+                    o.files.push(resolve(&name)?);
+                }
+            }
+            s if s.starts_with("--") => return Err(format!("unknown option \"{s}\"; see --help")),
+            name => o.files.push(resolve(name)?),
+        }
+    }
+    Ok(Some(o))
+}
+
+fn resolve(name: &str) -> Result<String, String> {
+    startup::absolute(name).map(|p| p.to_string_lossy().into_owned()).map_err(|e| format!("{name}: {e}"))
+}
+
+/// Runs without preferences (`GRIDCRAFT_NO_PREFS`, test runs) neither read nor write them, and
+/// keep no log file.
+fn prefs_enabled() -> bool {
+    std::env::var_os("GRIDCRAFT_NO_PREFS").is_none()
+}
+
+/// The settings folder (`ui.json`, `prefs.json`, the log). AROS has no per-user home:
+/// `GridCraftData` in the program's drawer, like a portable install, or the folder named by
+/// GRIDCRAFT_CONFIG_DIR (set at start-up when the user did not).
+fn config_dir() -> Option<PathBuf> {
+    std::env::var_os("GRIDCRAFT_CONFIG_DIR").filter(|d| !d.is_empty()).map(PathBuf::from)
+}
+
+/// A file name kept by a release that ran with DOS path names (`Work:Books/a.xlsx`), as the
+/// -nix name this one uses (`/Work/Books/a.xlsx`); other names are kept as they are.
+fn nix_name(name: &str) -> String {
+    if name.starts_with('/') || !name.contains(':') {
+        return name.to_owned();
+    }
+    startup::dos_to_nix(name).unwrap_or_else(|_| name.to_owned())
+}
+
+fn load_prefs(app: &mut SheetApp) {
+    if !prefs_enabled() {
+        return;
+    }
+    // First run (or a ui.json without a usable language): the system's language, as the desktop
+    // app does; English where the locale cannot be read.
+    app.ui.language = gridcraft_ui_egui::i18n::Language::system();
+    app.ui.system_theme = true;
+    let Some(dir) = config_dir() else { return };
+    if let Ok(b) = std::fs::read(dir.join("ui.json"))
+        && let Ok(ui) = serde_json::from_slice::<gridcraft_ui_egui::UiState>(&b)
+    {
+        let saved = serde_json::from_slice(&b).ok().and_then(|v| gridcraft_ui_egui::i18n::saved_language(&v));
+        let language = saved.unwrap_or(app.ui.language);
+        app.ui = ui.at_startup();
+        app.ui.language = language;
+        // Recent files saved by GridCraft 0.8.0 for AROS are DOS names.
+        for name in &mut app.ui.recent {
+            *name = nix_name(name);
+        }
+    }
+    if let Ok(b) = std::fs::read(dir.join("prefs.json"))
+        && let Ok(p) = serde_json::from_slice(&b)
+    {
+        app.session.prefs = p;
+    }
+}
+
+fn save_prefs(app: &SheetApp) {
+    if !prefs_enabled() {
+        return;
+    }
+    let Some(dir) = config_dir() else { return };
+    if let Err(e) = std::fs::create_dir_all(&dir) {
+        log::warn!("{}: {e}; settings not saved", dir.display());
+        return;
+    }
+    for (name, json) in [("ui.json", serde_json::to_vec_pretty(&app.ui)), ("prefs.json", serde_json::to_vec_pretty(&app.session.prefs))] {
+        if let Err(e) = json.map_err(std::io::Error::other).and_then(|b| std::fs::write(dir.join(name), b)) {
+            log::warn!("{name}: {e}");
+        }
+    }
+}
+
+/// Stops with `message`: on the console and, for a Workbench start, in a requester.
+fn fail(message: &str) -> std::process::ExitCode {
+    startup::show_error("GridCraft", message);
+    std::process::ExitCode::from(20)
+}
+
+// The main task's stack: a Shell start gives the program the Shell's (40,960 bytes on AROS One),
+// which the window loop overruns; the start-up code runs the program on 16 MiB instead.
+aros_startup::minimum_stack!(16 << 20);
+
+fn main() -> std::process::ExitCode {
+    // Unix-style probes (settings, fonts) must not open "insert volume" requesters.
+    startup::quiet_dos();
+    // ABIv11's C library keeps one saved directory for the whole process and restores it on the
+    // main task at exit; whichever task changes directory first decides what is saved. This
+    // chdir, before any worker can make one, keeps the main task's own (Workbench start) lock.
+    if let Err(e) = std::env::set_current_dir(".") {
+        return fail(&format!("cannot keep the start directory: {e}"));
+    }
+    let start = match startup::startup(&[launch::KEY]) {
+        Ok(s) => s,
+        Err(e) => return fail(&e),
+    };
+    SHELL.store(!start.workbench, std::sync::atomic::Ordering::Relaxed);
+    // Settings beside the program unless the user chose a folder: a portable drawer.
+    match startup::program_dir() {
+        Ok(dir) => startup::set_default_env("GRIDCRAFT_CONFIG_DIR", &dir.join("GridCraftData")),
+        Err(e) => return fail(&format!("cannot find the program's drawer: {e}")),
+    }
+    if prefs_enabled()
+        && let Some(dir) = config_dir()
+        && let Err(e) = std::fs::create_dir_all(&dir)
+    {
+        eprintln!("gridcraft: cannot create the settings folder {}: {e}", dir.display());
+    }
+    install_logger();
+    let mut args: Vec<String> = if start.workbench { Vec::new() } else { std::env::args().skip(1).collect() };
+    let env = std::env::var("GUI_RENDERER").ok();
+    let choice = match launch::choose(&mut args, &start.tooltypes, env.as_deref(), egui_aros::RendererRequest::Auto) {
+        Ok(c) => c,
+        Err(e) => return fail(&e),
+    };
+    let mut options = match parse_args(args) {
+        Ok(Some(o)) => o,
+        Ok(None) => return std::process::ExitCode::SUCCESS,
+        Err(e) => return fail(&e),
+    };
+    options.files.extend(start.files);
+    log::info!("GridCraft {RELEASE} for AROS ({TARGET}); start from {}", if start.workbench { "Workbench" } else { "Shell" });
+    log::info!("GUI_RENDERER requested {} (from {})", launch::request_name(choice.request), choice.source.name());
+    let code = run(options, choice);
+    log::info!("shutdown: exit({code})");
+    std::process::ExitCode::from(code)
+}
+
+fn new_app(shared_window: services::SharedWindow, options: &Options) -> SheetApp {
+    // RUST_LOG=debug: the start-up steps, to place a failure before the window opens.
+    log::debug!("start: session");
+    let mut session = gridcraft_engine::Session::new();
+    if let Some(name) = &options.sample
+        && let Err(e) = session.execute("file.new", serde_json::json!({"sample": name}))
+    {
+        log::warn!("sample {name}: {e}");
+    }
+    log::debug!("start: app");
+    let mut app = SheetApp::new(session, services::aros(shared_window));
+    log::debug!("start: preferences");
+    // No `watch_desktop_theme`: AROS has no desktop theme to read, and its watcher thread polls
+    // for good, so the pthread library's exit handler, which joins every thread, would wait for
+    // it forever. No `start_update_check`: releases come through the AROS package catalogue.
+    load_prefs(&mut app);
+    // After the preferences, so the startup workbook's author is the saved user name.
+    log::debug!("start: workbook");
+    if app.session.documents().is_empty() {
+        app.session.new_workbook();
+    }
+    log::debug!("start: engine messages");
+    app.after_engine();
+    log::debug!("start: {} file(s)", options.files.len());
+    // Files named on the command line, or shift-clicked with the icon, open as File › Open opens
+    // them: a password-protected one asks for its password, and errors are shown.
+    for f in &options.files {
+        app.open_path(f);
+    }
+    app
+}
+
+/// The spreadsheet as egui-aros runs it: the desktop app's eframe `logic` and `ui`, and the
+/// screenshot hook.
+struct Host {
+    app: SheetApp,
+    shared_window: services::SharedWindow,
+    ctx: egui::Context,
+    screenshot: Option<(String, u64)>,
+    done: bool,
+    renderer_logged: bool,
+    steps: std::collections::VecDeque<Step>,
+    frame: u64,
+    step_shot: Option<String>,
+    /// GRIDCRAFT_TRACE_INPUT: log every frame's key and text events and the focused widget, to
+    /// tell lost input from input that reached the wrong widget.
+    trace_input: bool,
+    /// Per frame: (whole frame, raster + present), for the summary in the log at shutdown.
+    frame_costs: Vec<(Duration, Duration)>,
+}
+
+/// One log line: frames, and the median, mean and longest frame and raster+present times.
+fn frame_summary(costs: &[(Duration, Duration)]) -> String {
+    let ms = |d: Duration| d.as_secs_f64() * 1000.0;
+    let stats = |mut v: Vec<f64>| {
+        v.sort_by(f64::total_cmp);
+        let mean = v.iter().sum::<f64>() / v.len().max(1) as f64;
+        let median = v.get(v.len() / 2).copied().unwrap_or(0.0);
+        let max = v.last().copied().unwrap_or(0.0);
+        format!("median {median:.0} ms, mean {mean:.0} ms, max {max:.0} ms")
+    };
+    if costs.is_empty() {
+        return "no frames".to_owned();
+    }
+    format!(
+        "{} frames; frame {}; raster+present {}",
+        costs.len(),
+        stats(costs.iter().map(|c| ms(c.0)).collect()),
+        stats(costs.iter().map(|c| ms(c.1)).collect())
+    )
+}
+
+impl egui_aros::App for Host {
+    fn started(&mut self, window: egui_aros::WindowHandle) {
+        *self.shared_window.borrow_mut() = Some(window);
+    }
+
+    // --screenshot needs the frame's pixels; with OpenGL they are read back only then.
+    fn wants_pixels(&self) -> bool {
+        self.screenshot.is_some() || self.step_shot.is_some()
+    }
+
+    fn raw_input_hook(&mut self, raw: &mut egui::RawInput) {
+        if self.trace_input {
+            for e in &raw.events {
+                if matches!(e, egui::Event::Key { .. } | egui::Event::Text(_) | egui::Event::Ime(_) | egui::Event::Paste(_)) {
+                    log::info!("input: {e:?}");
+                }
+            }
+        }
+        self.app.raw_input_hook(&self.ctx, raw);
+        // Files dropped on the window open as workbooks.
+        for f in std::mem::take(&mut raw.dropped_files) {
+            if let Some(p) = f.path().to_str().map(str::to_string).filter(|p| !p.is_empty()) {
+                self.app.open_path(&p);
+            }
+        }
+    }
+
+    fn logic(&mut self, ctx: &egui::Context) {
+        // --screenshot counts frames, and with no idle poll an untouched window draws none after
+        // it settles: keep drawing until the picture is taken.
+        if self.screenshot.is_some() && !self.done {
+            ctx.request_repaint();
+        }
+        // The app holds a close back itself (`guard_window_close`): with unsaved changes it
+        // cancels the close and asks, then closes the window once that is answered.
+        self.app.logic(ctx);
+        while self.steps.front().is_some_and(|s| s.frame <= self.frame) {
+            let Some(step) = self.steps.pop_front() else { break };
+            if let Some((id, params)) = step.run {
+                let r = self.app.run(&id, params);
+                log::info!("test step {}: {id}: {}", step.frame, match &r { Ok(v) => format!("ok {v}"), Err(e) => format!("error {e}") });
+            }
+            if step.screenshot.is_some() {
+                self.step_shot = step.screenshot;
+            }
+            if step.quit {
+                log::info!("test step {}: quit", step.frame);
+                self.done = true;
+            }
+            ctx.request_repaint();
+        }
+        if !self.steps.is_empty() {
+            ctx.request_repaint();
+        }
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui) {
+        self.app.ui(ui);
+        if self.trace_input {
+            let focused = ui.ctx().memory(|m| m.focused());
+            let editor = self.app.editor.as_ref().map(|e| (e.text.clone(), e.request_focus, e.from_formula_bar));
+            log::info!("frame: focused {focused:?}, editor {editor:?}");
+        }
+    }
+
+    fn quit_requested(&self) -> bool {
+        self.done
+    }
+
+    fn frame_done(&mut self, report: &egui_aros::FrameReport, renderer: &egui_aros::raster::Renderer) {
+        self.frame = report.frame;
+        let drawn = report.raster + report.present;
+        self.frame_costs.push((report.logic + report.ui + report.tessellate + report.textures + drawn, drawn));
+        // RUST_LOG=debug: one line per frame, to see what woke the loop and what the frame cost.
+        log::debug!(
+            "frame {} {}x{}: slept {:?} (timeout {:?}, by timeout {}), late {:?}, events {}, logic {:?} ui {:?} tessellate {:?} raster {:?} present {:?}, next repaint {:?}",
+            report.frame,
+            report.width,
+            report.height,
+            report.waited,
+            report.wait_timeout,
+            report.woke_by_timeout,
+            report.repaint_late,
+            report.events,
+            report.logic,
+            report.ui,
+            report.tessellate,
+            report.raster,
+            report.present,
+            report.next_repaint
+        );
+        if let Some(path) = self.step_shot.take() {
+            match write_png(&path, renderer) {
+                Ok(()) => log::info!("test step: wrote {path}"),
+                Err(e) => log::error!("test step: screenshot {path}: {e}"),
+            }
+        }
+        if !self.renderer_logged {
+            self.renderer_logged = true;
+            log::info!("GUI_RENDERER using {}", egui_aros::renderer_name());
+            log_tasks("first frame");
+        }
+        if let Some((path, frames)) = &self.screenshot
+            && report.frame >= *frames
+        {
+            match write_png(path, renderer) {
+                Ok(()) => log::info!("wrote {path}"),
+                Err(e) => log::error!("screenshot {path}: {e}"),
+            }
+            self.done = true;
+        }
+    }
+}
+
+fn run(mut options: Options, choice: launch::RendererChoice) -> u8 {
+    let (request, narrowed) = launch::effective(choice);
+    if let Some(why) = narrowed {
+        log::info!("GUI_RENDERER AUTO uses the CPU: {why}");
+    }
+    log::debug!("start: screen");
+    // As large as the screen allows, up to the desktop app's 1440x900; --window sets it exactly.
+    let (sw, sh) = egui_aros::screen_size().map_or((1456, 948), |(w, h)| (w as i32, h as i32));
+    let (w, h) = options.window.unwrap_or((1440.min(sw - 16).max(640), 900.min(sh - 48).max(420)));
+    let (w, h) = (w.max(1) as u32, h.max(1) as u32);
+    let ctx = egui::Context::default();
+    let shared_window: services::SharedWindow = Rc::new(RefCell::new(None));
+    let app = new_app(shared_window.clone(), &options);
+    log::debug!("start: fonts and language");
+    SheetApp::setup_context_for_language(&ctx, app.ui.dark, app.ui.language);
+    log::debug!("start: window");
+    log_tasks("app created");
+    let mut host = Host {
+        app,
+        shared_window,
+        ctx: ctx.clone(),
+        screenshot: options.screenshot.clone().map(|p| (p, options.screenshot_frames)),
+        done: false,
+        renderer_logged: false,
+        steps: options.test_steps.drain(..).collect(),
+        frame: 0,
+        step_shot: None,
+        trace_input: std::env::var_os("GRIDCRAFT_TRACE_INPUT").is_some(),
+        frame_costs: Vec::new(),
+    };
+    let run_options = egui_aros::Options {
+        title: "GridCraft".to_owned(),
+        inner_size: (w, h),
+        min_inner_size: Some((640, 420)),
+        clear_color: [0xf3, 0xf3, 0xf3],
+        // No idle poll: as eframe on the desktop, the loop sleeps until input, a repaint the app
+        // asks for (it does while it waits for a background open, shows a timed message or has an
+        // AutoSave due), or a wake-up from another thread. A poll is a full frame, which the CPU
+        // renderer pays for in full.
+        idle_poll: None,
+        renderer: request,
+        ..Default::default()
+    };
+    // A panic below the app (renderer, window) unwinds to here on ABIv11, so the shutdown below
+    // still runs.
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| egui_aros::run(run_options, ctx, &mut host)))
+        .unwrap_or_else(|_| Err(egui_aros::Error::Window("the window loop stopped after a panic".into())));
+    if let Some(info) = egui_aros::renderer_info() {
+        log::info!("GUI_RENDERER {}", info.summary());
+    }
+    log::info!("frames: {}", frame_summary(&host.frame_costs));
+    // The services hold the window handle; let go of it with the window.
+    *host.shared_window.borrow_mut() = None;
+    let code = match result {
+        Ok(()) => 0,
+        Err(e) => {
+            log::error!("{e}");
+            if !SHELL.load(std::sync::atomic::Ordering::Relaxed) {
+                startup::show_error("GridCraft", &e.to_string());
+            }
+            20
+        }
+    };
+    if host.screenshot.is_none() {
+        save_prefs(&host.app);
+    }
+    drop(host);
+    log::info!("shutdown: application state dropped");
+    // AROS's pthread library waits for every thread when the program exits: name the tasks still
+    // there, so a worker that does not end can be found in the log.
+    log_tasks("shutdown");
+    code
+}
+
+/// Logs the program's threads still present (`pthread thread #N` on AROS), at shutdown and, with
+/// GRIDCRAFT_LOG_TASKS set, at start-up points too.
+fn log_tasks(when: &str) {
+    if when != "shutdown" && std::env::var_os("GRIDCRAFT_LOG_TASKS").is_none() {
+        return;
+    }
+    let threads: Vec<String> = startup::task_names().into_iter().filter(|t| t.starts_with("pthread")).collect();
+    log::info!("{when}: threads: {}", if threads.is_empty() { "none".to_owned() } else { threads.join(", ").replace('\t', ":") });
+}
+
+fn write_png(path: &str, r: &egui_aros::raster::Renderer) -> Result<(), String> {
+    let img = image::RgbaImage::from_raw(r.width as u32, r.height as u32, r.frame.clone()).ok_or("frame size mismatch")?;
+    img.save_with_format(path, image::ImageFormat::Png).map_err(|e| e.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args(list: &[&str]) -> Vec<String> {
+        list.iter().map(|s| (*s).to_owned()).collect()
+    }
+
+    #[test]
+    fn sample_alone_is_the_sales_sample() {
+        let o = parse_args(args(&["--sample", "--window", "800x600"])).ok().flatten();
+        assert_eq!(o.as_ref().and_then(|o| o.sample.as_deref()), Some("sales"));
+        assert_eq!(o.and_then(|o| o.window), Some((800, 600)));
+        let o = parse_args(args(&["--sample", "budget"])).ok().flatten();
+        assert_eq!(o.and_then(|o| o.sample), Some("budget".to_owned()));
+    }
+
+    #[test]
+    fn unknown_options_and_the_control_server_are_refused() {
+        assert!(parse_args(args(&["--nope"])).is_err());
+        assert!(parse_args(args(&["--control", "9000"])).is_err());
+        assert!(parse_args(args(&["--window", "wide"])).is_err());
+    }
+
+    #[test]
+    fn names_from_a_release_with_dos_paths_are_left_alone_when_already_nix() {
+        assert_eq!(nix_name("/Work/Books/a.xlsx"), "/Work/Books/a.xlsx");
+        assert_eq!(nix_name("a.xlsx"), "a.xlsx");
+    }
+}
