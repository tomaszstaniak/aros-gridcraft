@@ -0,0 +1,388 @@
+//! A chart's drawing primitives, kept between frames.
+//!
+//! Resolving a chart's series from the workbook and laying the chart out again is the same work
+//! every frame until something the chart is made from changes. The cache keeps the result of
+//! [`gridcraft_chart::resolve`] and [`gridcraft_chart::render`] for each chart on screen and
+//! hands it back while its inputs are the same:
+//!
+//! - the workbook, by identity: every edit, undo, redo, recalculation or import replaces the
+//!   workbook's `Arc`, so a chart is never drawn from older cells, also when the cells are on
+//!   another sheet. Scrolling and moving the selection do not replace it;
+//! - the chart (document, sheet and chart id), its size, the zoom and the pixel density, and the
+//!   fonts its text is measured with ([`fonts_epoch`]).
+//!
+//! The workbook is held weakly: the cache keeps no workbook alive, and the allocation a `Weak`
+//! holds is not handed to a new workbook, so an address can never stand for two of them.
+//! Storing the view state (scroll position, active cell) with the file replaces the `Arc`
+//! without changing what a chart shows; [`ChartCache::rebind`] carries the entries over.
+//!
+//! The cache is bounded ([`MAX_ENTRIES`], [`MAX_BYTES`]); the least recently used entries go
+//! first, and a chart whose primitives alone exceed [`MAX_ENTRY_BYTES`] is drawn without being
+//! kept.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Weak};
+
+use gridcraft_chart::Prim;
+use gridcraft_engine::model::Workbook;
+
+/// At most this many charts are kept.
+pub const MAX_ENTRIES: usize = 128;
+/// At most this many bytes of primitives are kept (an estimate of their owned allocations).
+pub const MAX_BYTES: usize = 16 << 20;
+/// One chart's primitives are kept only up to this size.
+pub const MAX_ENTRY_BYTES: usize = 4 << 20;
+
+/// Counts the font set-ups of `ctx`: a chart's text is measured with the fonts egui has, so every
+/// change of them starts new entries. Kept with the context, so each window system context (and
+/// each test) counts its own.
+pub fn fonts_epoch(ctx: &egui::Context) -> u64 {
+    ctx.data(|d| d.get_temp::<u64>(fonts_epoch_id()).unwrap_or(0))
+}
+
+/// Call whenever the fonts given to `ctx` change.
+pub fn fonts_changed(ctx: &egui::Context) {
+    ctx.data_mut(|d| {
+        let epoch = d.get_temp_mut_or_default::<u64>(fonts_epoch_id());
+        *epoch = epoch.wrapping_add(1);
+    });
+}
+
+fn fonts_epoch_id() -> egui::Id {
+    egui::Id::unique("gridcraft-chart-cache-fonts-epoch")
+}
+
+/// What, beside the workbook, a chart's primitives depend on.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct ChartKey {
+    /// The open workbook ([`gridcraft_engine::DocState::uid`]).
+    pub doc: u64,
+    pub sheet: usize,
+    /// The chart's id on its sheet.
+    pub chart: u32,
+    width: u32,
+    height: u32,
+    zoom: u32,
+    pixels_per_point: u32,
+    fonts: u64,
+}
+
+impl ChartKey {
+    /// `fonts` is [`fonts_epoch`] of the context the chart is drawn in.
+    pub fn new(doc: u64, sheet: usize, chart: u32, size: (f32, f32), zoom: f32, pixels_per_point: f32, fonts: u64) -> Self {
+        Self {
+            doc,
+            sheet,
+            chart,
+            width: size.0.to_bits(),
+            height: size.1.to_bits(),
+            zoom: zoom.to_bits(),
+            pixels_per_point: pixels_per_point.to_bits(),
+            fonts,
+        }
+    }
+}
+
+struct Entry {
+    workbook: Weak<Workbook>,
+    prims: Arc<Vec<Prim>>,
+    bytes: usize,
+    used: u64,
+}
+
+/// Counters for tests and measurements.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ChartCacheStats {
+    /// Charts drawn from kept primitives.
+    pub hits: u64,
+    /// Charts resolved and laid out.
+    pub misses: u64,
+    /// Entries dropped to stay within the bounds.
+    pub evictions: u64,
+    /// Charts too large to keep.
+    pub uncached: u64,
+    pub entries: usize,
+    pub bytes: usize,
+}
+
+#[derive(Default)]
+pub struct ChartCache {
+    entries: HashMap<ChartKey, Entry>,
+    bytes: usize,
+    tick: u64,
+    hits: u64,
+    misses: u64,
+    evictions: u64,
+    uncached: u64,
+}
+
+/// The owned allocations of `prims`, estimated from capacities.
+fn prims_bytes(prims: &[Prim]) -> usize {
+    let own = std::mem::size_of_val(prims);
+    prims.iter().fold(own, |sum, prim| {
+        sum.saturating_add(match prim {
+            Prim::Line { pts, .. } | Prim::Polygon { pts, .. } => pts.capacity().saturating_mul(std::mem::size_of::<[f32; 2]>()),
+            Prim::Text { text, .. } => text.capacity(),
+            Prim::Rect { .. } | Prim::Wedge { .. } | Prim::Circle { .. } => 0,
+        })
+    })
+}
+
+impl ChartCache {
+    /// The primitives of the chart `key` names in `workbook`: the kept ones while the workbook
+    /// is the one they were made from, otherwise `make`'s, which are kept for the next frame.
+    pub fn prims(&mut self, key: ChartKey, workbook: &Arc<Workbook>, make: impl FnOnce() -> Vec<Prim>) -> Arc<Vec<Prim>> {
+        self.tick += 1;
+        if let Some(entry) = self.entries.get_mut(&key)
+            && std::ptr::eq(entry.workbook.as_ptr(), Arc::as_ptr(workbook))
+        {
+            entry.used = self.tick;
+            self.hits += 1;
+            return entry.prims.clone();
+        }
+        self.misses += 1;
+        let prims = Arc::new(make());
+        let bytes = prims_bytes(&prims);
+        if let Some(old) = self.entries.remove(&key) {
+            self.bytes = self.bytes.saturating_sub(old.bytes);
+        }
+        if bytes > MAX_ENTRY_BYTES {
+            self.uncached += 1;
+            return prims;
+        }
+        while !self.entries.is_empty() && (self.entries.len() >= MAX_ENTRIES || self.bytes.saturating_add(bytes) > MAX_BYTES) {
+            let Some(oldest) = self.entries.iter().min_by_key(|(_, e)| e.used).map(|(k, _)| *k) else { break };
+            if let Some(old) = self.entries.remove(&oldest) {
+                self.bytes = self.bytes.saturating_sub(old.bytes);
+                self.evictions += 1;
+            }
+        }
+        self.bytes = self.bytes.saturating_add(bytes);
+        self.entries.insert(key, Entry { workbook: Arc::downgrade(workbook), prims: prims.clone(), bytes, used: self.tick });
+        prims
+    }
+
+    /// The workbook of `doc` was replaced by `new` without a change a chart can show (the view
+    /// state stored with the file): entries made from `old` stay valid for `new`.
+    pub fn rebind(&mut self, doc: u64, old: *const Workbook, new: &Arc<Workbook>) {
+        if std::ptr::eq(old, Arc::as_ptr(new)) {
+            return;
+        }
+        for (key, entry) in &mut self.entries {
+            if key.doc == doc && std::ptr::eq(entry.workbook.as_ptr(), old) {
+                entry.workbook = Arc::downgrade(new);
+            }
+        }
+    }
+
+    /// Drops the entries of workbooks that are no longer open.
+    pub fn retain_documents(&mut self, open: &[u64]) {
+        let bytes = &mut self.bytes;
+        self.entries.retain(|key, entry| {
+            let keep = open.contains(&key.doc);
+            if !keep {
+                *bytes = bytes.saturating_sub(entry.bytes);
+            }
+            keep
+        });
+    }
+
+    pub fn stats(&self) -> ChartCacheStats {
+        ChartCacheStats {
+            hits: self.hits,
+            misses: self.misses,
+            evictions: self.evictions,
+            uncached: self.uncached,
+            entries: self.entries.len(),
+            bytes: self.bytes,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn workbook() -> Arc<Workbook> {
+        Arc::new(Workbook::default())
+    }
+
+    fn key(doc: u64, chart: u32) -> ChartKey {
+        ChartKey::new(doc, 0, chart, (400.0, 240.0), 1.0, 1.0, 1)
+    }
+
+    fn text(s: &str) -> Vec<Prim> {
+        vec![Prim::Text {
+            x: 0.0,
+            y: 0.0,
+            text: s.to_string(),
+            size: 10.0,
+            color: [0, 0, 0, 255],
+            bold: false,
+            align: gridcraft_chart::HAlign::Left,
+            valign: gridcraft_chart::VAlign::Top,
+            rotation: 0.0,
+        }]
+    }
+
+    fn label(prims: &[Prim]) -> &str {
+        match prims.first() {
+            Some(Prim::Text { text, .. }) => text,
+            _ => "",
+        }
+    }
+
+    #[test]
+    fn a_chart_is_made_once_while_its_workbook_stays() {
+        let mut cache = ChartCache::default();
+        let wb = workbook();
+        let mut made = 0;
+        let k = key(1, 7);
+        for _ in 0..100 {
+            let prims = cache.prims(k, &wb, || {
+                made += 1;
+                text("first")
+            });
+            assert_eq!(label(&prims), "first");
+        }
+        assert_eq!(made, 1);
+        let stats = cache.stats();
+        assert_eq!((stats.misses, stats.hits, stats.entries), (1, 99, 1));
+    }
+
+    #[test]
+    fn a_replaced_workbook_makes_the_chart_again() {
+        let mut cache = ChartCache::default();
+        let before = workbook();
+        let k = key(1, 7);
+        cache.prims(k, &before, || text("before"));
+        // An edit: the document has a new workbook, the old one lives on in the undo history.
+        let after = workbook();
+        let prims = cache.prims(k, &after, || text("after"));
+        assert_eq!(label(&prims), "after");
+        // Undo brings the old workbook back: the entry was replaced, so it is made again too.
+        let prims = cache.prims(k, &before, || text("before again"));
+        assert_eq!(label(&prims), "before again");
+        assert_eq!(cache.stats().entries, 1);
+    }
+
+    #[test]
+    fn a_new_workbook_at_a_freed_address_is_not_mistaken_for_the_old_one() {
+        let mut cache = ChartCache::default();
+        let first = workbook();
+        let address = Arc::as_ptr(&first);
+        let k = key(1, 7);
+        cache.prims(k, &first, || text("first"));
+        drop(first);
+        // The cache's weak reference keeps the allocation, so no later workbook gets the address.
+        let later: Vec<Arc<Workbook>> = (0..64).map(|_| workbook()).collect();
+        assert!(later.iter().all(|wb| !std::ptr::eq(Arc::as_ptr(wb), address)));
+        let prims = cache.prims(k, &later[0], || text("later"));
+        assert_eq!(label(&prims), "later");
+    }
+
+    #[test]
+    fn size_zoom_density_fonts_sheet_and_document_are_separate_entries() {
+        let mut cache = ChartCache::default();
+        let wb = workbook();
+        let base = key(1, 7);
+        cache.prims(base, &wb, || text("base"));
+        let with = |f: fn(&mut ChartKey)| {
+            let mut k = base;
+            f(&mut k);
+            k
+        };
+        let others = [
+            with(|k| k.width = 401.0f32.to_bits()),
+            with(|k| k.height = 241.0f32.to_bits()),
+            with(|k| k.zoom = 1.25f32.to_bits()),
+            with(|k| k.pixels_per_point = 2.0f32.to_bits()),
+            with(|k| k.sheet = 1),
+            with(|k| k.doc = 2),
+            with(|k| k.chart = 8),
+        ];
+        for (i, other) in others.iter().enumerate() {
+            let prims = cache.prims(*other, &wb, || text(&format!("other {i}")));
+            assert_eq!(label(&prims), format!("other {i}"));
+        }
+        assert_eq!(label(&cache.prims(base, &wb, || text("made again"))), "base");
+        let renewed = with(|k| k.fonts = 2);
+        assert_eq!(label(&cache.prims(renewed, &wb, || text("new fonts"))), "new fonts");
+    }
+
+    #[test]
+    fn each_context_counts_its_own_font_changes() {
+        let (one, two) = (egui::Context::default(), egui::Context::default());
+        assert_eq!(fonts_epoch(&one), fonts_epoch(&two));
+        fonts_changed(&one);
+        fonts_changed(&one);
+        assert_eq!(fonts_epoch(&one), fonts_epoch(&two) + 2);
+    }
+
+    #[test]
+    fn storing_the_view_keeps_the_entries() {
+        let mut cache = ChartCache::default();
+        let before = workbook();
+        let (one, two) = (key(1, 7), key(2, 7));
+        cache.prims(one, &before, || text("kept"));
+        cache.prims(two, &before, || text("another document"));
+        let after = workbook();
+        cache.rebind(1, Arc::as_ptr(&before), &after);
+        assert_eq!(label(&cache.prims(one, &after, || text("made again"))), "kept");
+        // Only that document's entries move.
+        assert_eq!(label(&cache.prims(two, &after, || text("made again"))), "made again");
+    }
+
+    #[test]
+    fn closing_a_document_drops_its_entries() {
+        let mut cache = ChartCache::default();
+        let wb = workbook();
+        cache.prims(key(1, 7), &wb, || text("one"));
+        cache.prims(key(2, 7), &wb, || text("two"));
+        let both = cache.stats().bytes;
+        cache.retain_documents(&[2]);
+        let stats = cache.stats();
+        assert_eq!(stats.entries, 1);
+        assert!(stats.bytes < both && stats.bytes > 0);
+        cache.retain_documents(&[]);
+        assert_eq!((cache.stats().entries, cache.stats().bytes), (0, 0));
+    }
+
+    #[test]
+    fn the_cache_stays_within_its_bounds() {
+        let mut cache = ChartCache::default();
+        let wb = workbook();
+        let keys: Vec<ChartKey> = (0..(MAX_ENTRIES as u32 + 40)).map(|chart| key(1, chart)).collect();
+        for k in &keys {
+            cache.prims(*k, &wb, || text("x"));
+        }
+        let stats = cache.stats();
+        assert_eq!(stats.entries, MAX_ENTRIES);
+        assert_eq!(stats.evictions, 40);
+        // The oldest went first: the newest is still there.
+        assert_eq!(keys.last().map(|k| label(&cache.prims(*k, &wb, || text("made again"))).to_string()).as_deref(), Some("x"));
+        assert_eq!(keys.first().map(|k| label(&cache.prims(*k, &wb, || text("made again"))).to_string()).as_deref(), Some("made again"));
+
+        let mut cache = ChartCache::default();
+        let big = "y".repeat(MAX_BYTES / 6);
+        for chart in 0..12 {
+            cache.prims(key(1, chart), &wb, || text(&big));
+        }
+        assert!(cache.stats().bytes <= MAX_BYTES, "{} bytes kept", cache.stats().bytes);
+        assert!(cache.stats().entries < 12);
+    }
+
+    #[test]
+    fn a_chart_too_large_to_keep_is_still_drawn() {
+        let mut cache = ChartCache::default();
+        let wb = workbook();
+        let huge = "z".repeat(MAX_ENTRY_BYTES + 1);
+        let k = key(1, 7);
+        let prims = cache.prims(k, &wb, || text(&huge));
+        assert_eq!(label(&prims).len(), MAX_ENTRY_BYTES + 1);
+        let stats = cache.stats();
+        assert_eq!((stats.entries, stats.bytes, stats.uncached), (0, 0, 1));
+        cache.prims(k, &wb, || text(&huge));
+        assert_eq!(cache.stats().misses, 2);
+    }
+}
