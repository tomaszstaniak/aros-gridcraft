diff --git a/crates/ui-egui/tests/chart_cache.rs b/crates/ui-egui/tests/chart_cache.rs
new file mode 100644
index 0000000000000000000000000000000000000000..02f3226cf6a248ba456413092cd2a8f5c5abab58
--- /dev/null
+++ b/crates/ui-egui/tests/chart_cache.rs
@@ -0,0 +1,167 @@
+//! A chart on the sheet is resolved and laid out once and then drawn from the kept primitives
+//! until something it is made from changes: frames, scrolling, the selection and the stored view
+//! state do not make it again; an edit (on any sheet), undo and a zoom change do.
+
+#[path = "common/mod.rs"]
+mod common;
+
+use common::Harness;
+use gridcraft_engine::Session;
+use serde_json::json;
+
+/// The sales sample: a dashboard sheet with a chart in view.
+fn harness() -> Harness {
+    let mut session = Session::new();
+    session.execute("file.new", json!({"sample": "sales"})).unwrap();
+    common::os_harness(session, egui::os::OperatingSystem::Nix)
+}
+
+fn made(h: &Harness) -> u64 {
+    h.state().chart_cache_stats().misses
+}
+
+fn run(h: &mut Harness, id: &str, params: serde_json::Value) {
+    h.state_mut().run(id, params).unwrap_or_else(|e| panic!("{id}: {e}"));
+    h.run_steps(3);
+}
+
+#[test]
+fn frames_draw_the_chart_from_the_kept_primitives() {
+    let mut h = harness();
+    let first = h.state().chart_cache_stats();
+    assert!(first.misses >= 1, "the sample shows a chart: {first:?}");
+    assert_eq!(first.entries as u64, first.misses, "one entry per chart in view");
+    h.run_steps(40);
+    let later = h.state().chart_cache_stats();
+    assert_eq!(later.misses, first.misses, "no chart was made again");
+    assert!(later.hits >= first.hits + 40, "every frame drew from the cache: {later:?}");
+}
+
+#[test]
+fn the_selection_scrolling_and_the_stored_view_keep_the_chart() {
+    let mut h = harness();
+    let before = made(&h);
+    run(&mut h, "selection.set", json!({"range": "A1:D4"}));
+    run(&mut h, "selection.set", json!({"cell": "C9"}));
+    h.input_mut().events.push(egui::Event::MouseWheel {
+        unit: egui::MouseWheelUnit::Line,
+        delta: egui::vec2(0.0, -1.0),
+        phase: egui::TouchPhase::Move,
+        modifiers: egui::Modifiers::NONE,
+        source: egui::MouseWheelSource::Unknown,
+    });
+    h.run_steps(4);
+    // What File > Save does before it writes: the active cell and scroll position go into the
+    // workbook. Something else holds the workbook too (the undo history, the saved state), so
+    // the document gets a new `Arc`.
+    let held = h.state().session.active().unwrap().wb.clone();
+    h.state_mut().store_view_state();
+    assert!(!std::sync::Arc::ptr_eq(&held, &h.state().session.active().unwrap().wb), "the view state replaced the workbook");
+    h.run_steps(4);
+    assert_eq!(made(&h), before, "{:?}", h.state().chart_cache_stats());
+}
+
+#[test]
+fn an_edit_makes_the_chart_again_and_so_does_undo() {
+    let mut h = harness();
+    let before = made(&h);
+    run(&mut h, "cell.set", json!({"cell": "B3", "input": "12345"}));
+    let edited = made(&h);
+    assert!(edited > before, "the chart follows the edit");
+    h.run_steps(10);
+    assert_eq!(made(&h), edited, "and is kept again afterwards");
+    run(&mut h, "edit.undo", json!({}));
+    assert!(made(&h) > edited, "undo brings other cells back");
+}
+
+#[test]
+fn an_edit_on_another_sheet_makes_the_chart_again() {
+    let mut h = harness();
+    let chart_sheet = h.state().session.active().unwrap().wb.active().unwrap().name.clone();
+    run(&mut h, "home.insertSheet", json!({}));
+    run(&mut h, "cell.set", json!({"cell": "A1", "input": "1"}));
+    // Back to the sheet with the chart.
+    run(&mut h, "sheet.activate", json!({"sheet": chart_sheet}));
+    assert_eq!(h.state().session.active().unwrap().wb.active().unwrap().name, chart_sheet);
+    h.run_steps(10);
+    let before = made(&h);
+    h.run_steps(5);
+    assert_eq!(made(&h), before, "{:?}", h.state().chart_cache_stats());
+    // A cell of the other sheet, changed while the chart's sheet is shown.
+    let other = h.state().session.active().unwrap().wb.sheets.iter().position(|s| s.cells.len() == 1).expect("the new sheet");
+    let name = h.state().session.active().unwrap().wb.sheets[other].name.clone();
+    run(&mut h, "cell.set", json!({"cell": format!("{name}!A1"), "input": "2"}));
+    assert!(made(&h) > before, "a chart may read any sheet, so any edit makes it again");
+}
+
+#[test]
+fn a_zoom_change_makes_the_chart_again() {
+    let mut h = harness();
+    let before = made(&h);
+    run(&mut h, "view.zoom", json!({"percent": 120}));
+    assert!(made(&h) > before);
+}
+
+#[test]
+fn closing_the_workbook_drops_its_charts() {
+    let mut h = harness();
+    assert!(h.state().chart_cache_stats().entries >= 1);
+    run(&mut h, "file.close", json!({"force": true, "document": true}));
+    assert_eq!(h.state().chart_cache_stats().entries, 0);
+    assert_eq!(h.state().chart_cache_stats().bytes, 0);
+}
+
+/// A measurement, not a check (`--ignored --nocapture`, best with `--release`): frames of the
+/// sales sample with the charts kept, and with the charts made every frame as before the cache
+/// (a font change before each frame starts new entries).
+#[test]
+#[ignore = "prints frame times"]
+fn measure_frames_with_and_without_kept_charts() {
+    const FRAMES: usize = 300;
+    let mut h = harness();
+    h.run_steps(20);
+    let start = gridcraft_ui_egui::monotonic_ms();
+    h.run_steps(FRAMES);
+    let kept = gridcraft_ui_egui::monotonic_ms() - start;
+    let kept_made = made(&h);
+    let start = gridcraft_ui_egui::monotonic_ms();
+    for _ in 0..FRAMES {
+        gridcraft_ui_egui::chart_cache::fonts_changed(&h.ctx);
+        h.run_steps(1);
+    }
+    let remade = gridcraft_ui_egui::monotonic_ms() - start;
+    println!(
+        "sales sample, {FRAMES} frames: kept {:.3} ms/frame; made every frame {:.3} ms/frame ({} made)",
+        kept / FRAMES as f64,
+        remade / FRAMES as f64,
+        made(&h) - kept_made
+    );
+
+    // A line chart over 4 columns of 2000 rows.
+    let mut session = Session::new();
+    session.new_workbook();
+    let rows: Vec<Vec<f64>> = (0..2000).map(|r| (0..4).map(|c| f64::from(r * (c + 1) % 97)).collect()).collect();
+    session.execute("range.setValues", json!({"range": "A1", "values": rows})).unwrap();
+    session.execute("selection.set", json!({"range": "A1:D2000"})).unwrap();
+    session.execute("insert.chart", json!({"type": "line"})).unwrap();
+    let mut h = common::os_harness(session, egui::os::OperatingSystem::Nix);
+    h.run_steps(20);
+    assert!(made(&h) >= 1, "the chart is in view");
+    let before = made(&h);
+    let start = gridcraft_ui_egui::monotonic_ms();
+    h.run_steps(FRAMES);
+    let kept = gridcraft_ui_egui::monotonic_ms() - start;
+    assert_eq!(made(&h), before);
+    let start = gridcraft_ui_egui::monotonic_ms();
+    for _ in 0..FRAMES {
+        gridcraft_ui_egui::chart_cache::fonts_changed(&h.ctx);
+        h.run_steps(1);
+    }
+    let remade = gridcraft_ui_egui::monotonic_ms() - start;
+    println!(
+        "line chart of 4 x 2000 points, {FRAMES} frames: kept {:.3} ms/frame; made every frame {:.3} ms/frame ({} made)",
+        kept / FRAMES as f64,
+        remade / FRAMES as f64,
+        made(&h) - before
+    );
+}
