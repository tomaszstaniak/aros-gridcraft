+        // the chart's size, the zoom or the fonts change (see `chart_cache`).
+        let key = crate::chart_cache::ChartKey::new(
+            doc,
+            si,
+            ch.id,
+            (ch.anchor.width, ch.anchor.height),
+            geo.z,
+            p.ctx().pixels_per_point(),
+            crate::chart_cache::fonts_epoch(p.ctx()),
+        );
+        let prims = app.chart_cache.borrow_mut().prims(key, wb, || {
+            let data = gridcraft_chart::resolve(wb, si, ch);
+            let m = EguiMeasure { painter: p, z: geo.z };
+            gridcraft_chart::render(ch, &data, ch.anchor.width, ch.anchor.height, &m)
+        });
         paint_prims(&p.with_clip_rect(r.intersect(p.clip_rect())), r.min, &prims, geo.z);
         done(start, r);
     }
