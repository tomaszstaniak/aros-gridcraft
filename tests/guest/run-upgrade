.KEY RUNDIR/A,MACHINE/A
.BRA [
.KET ]
; Upgrade check with apkg from local indexes, everything under RAM:. Payload in RAM:t: apkg,
; old.zip + idx-old.json (the previous release), gc.zip + idx.json (the new package),
; steps-pkg.json, steps-pkg2.json, hello.xlsx. The previous release is installed and used once, then
; upgraded; the new program is verified, used twice and removed. old.log and GridCraft.log hold
; the frame costs of the same scripted session before and after.
; Execute RAM:t/run-upgrade <results directory> <machine name>
FailAt 21
Protect RAM:t/apkg +e
MakeDir RAM:pk
MakeDir RAM:pk/cache
Copy RAM:t/old.zip RAM:pk/cache/gridcraft.zip
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx-old.json install gridcraft --yes >[RUNDIR]/old-install.txt
Echo $RC >[RUNDIR]/old-install.rc
SetEnv RUST_LOG info
RAM:pk/GridCraft/GridCraft --window 780x540 --test-steps RAM:t/steps-pkg.json RAM:t/hello.xlsx
Echo $RC >[RUNDIR]/old-gui.rc
Copy RAM:pk/GridCraft/GridCraftData/GridCraft.log [RUNDIR]/old.log
Delete RAM:pk/GridCraft/GridCraftData/GridCraft.log QUIET
Echo "user file kept across the upgrade" >RAM:pk/GridCraft/GridCraftData/marker.txt
List RAM:pk/GridCraft ALL >[RUNDIR]/before-upgrade.txt
Copy RAM:t/gc.zip RAM:pk/cache/gridcraft.new.zip
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json outdated >[RUNDIR]/outdated.txt
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json upgrade gridcraft --yes >[RUNDIR]/upgrade.txt
Echo $RC >[RUNDIR]/upgrade.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json verify gridcraft >[RUNDIR]/verify.txt
Echo $RC >[RUNDIR]/verify.rc
List RAM:pk/GridCraft ALL >[RUNDIR]/after-upgrade.txt
Type RAM:pk/GridCraft/GridCraftData/marker.txt >[RUNDIR]/marker.txt
RAM:pk/GridCraft/gridcraft-cli version >[RUNDIR]/cli-version.txt
Echo $RC >[RUNDIR]/cli-version.rc
RAM:pk/GridCraft/GridCraft --version >[RUNDIR]/gui-version.txt
RAM:pk/GridCraft/GridCraft --window 780x540 --test-steps RAM:t/steps-pkg.json RAM:t/hello.xlsx
Echo $RC >[RUNDIR]/gui.rc
RAM:pk/GridCraft/gridcraft-cli cat RAM:t/pkg-saved.xlsx --formulas >[RUNDIR]/saved-info.txt
Echo $RC >[RUNDIR]/saved-info.rc
RAM:pk/GridCraft/GridCraft --window 780x540 --test-steps RAM:t/steps-pkg2.json
Echo $RC >[RUNDIR]/gui2.rc
Copy RAM:pk/GridCraft/GridCraftData/GridCraft.log [RUNDIR]/GridCraft.log
Copy RAM:pk/GridCraft/BUILD.txt [RUNDIR]/BUILD.txt
Copy RAM:t/pkg-b.png [RUNDIR]/pkg-b.png
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json remove gridcraft --yes >[RUNDIR]/remove.txt
Echo $RC >[RUNDIR]/remove.rc
List RAM:pk ALL >[RUNDIR]/after-remove.txt
Echo "done" >[RUNDIR]/upgrade-done.txt
