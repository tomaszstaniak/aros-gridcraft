.KEY RUNDIR/A,MACHINE/A
.BRA [
.KET ]
; GridCraft package check with apkg from a local index. Put into RAM:t: apkg (for this system),
; gc.zip (the package), idx.json (a test index naming it), hello.xlsx, steps-pkg.json.
; Then: Execute RAM:t/run-pkg <results directory> <machine name>. Everything stays under RAM:.
FailAt 21
Protect RAM:t/apkg +e
MakeDir RAM:pk
MakeDir RAM:pk/cache
Copy RAM:t/gc.zip RAM:pk/cache/gridcraft.zip
RAM:t/apkg --version >[RUNDIR]/apkg-version.txt
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json show gridcraft >[RUNDIR]/show.txt
Echo $RC >[RUNDIR]/show.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json install gridcraft --yes >[RUNDIR]/install.txt
Echo $RC >[RUNDIR]/install.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json verify gridcraft >[RUNDIR]/verify.txt
Echo $RC >[RUNDIR]/verify.rc
List RAM:pk ALL >[RUNDIR]/installed.txt
RAM:pk/GridCraft/gridcraft-cli version >[RUNDIR]/cli-version.txt
Echo $RC >[RUNDIR]/cli-version.rc
SetEnv RUST_LOG info
RAM:pk/GridCraft/GridCraft --window 780x540 --test-steps RAM:t/steps-pkg.json RAM:t/hello.xlsx
Echo $RC >[RUNDIR]/gui.rc
RAM:pk/GridCraft/gridcraft-cli cat RAM:t/pkg-saved.xlsx --formulas >[RUNDIR]/saved-cat.txt
Echo $RC >[RUNDIR]/saved-cat.rc
List RAM:pk/GridCraft/GridCraftData >[RUNDIR]/data.txt
Copy RAM:pk/GridCraft/GridCraftData/GridCraft.log [RUNDIR]/GridCraft.log
Copy RAM:pk/GridCraft/BUILD.txt [RUNDIR]/BUILD.txt
